\name{multiFSYNC-package}
\alias{multiFSYNC-package}
\alias{multiFSYNC}
\title{Multi-Study Bayesian Functional Factor Model}
\description{
Fits a Bayesian multi-study factor model for high-dimensional continuous
functional data, separating shared and study-specific factor processes and
allowing time-varying coefficient functions for scalar covariates.
}
\details{
The fitting algorithm uses unconstrained computational scores and spline time
functions. Canonical FPCA parameters are recovered by posterior-moment
post-processing. See the package README and NOTATION.md for the distinction
between computational and theoretical parameters.
}
\docType{package}
