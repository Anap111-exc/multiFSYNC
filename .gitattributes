# Keep source and protocol hashes stable across Windows and Linux clones.
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
DESCRIPTION text eol=lf
NAMESPACE text eol=lf
*.R text eol=lf
*.Rd text eol=lf
*.Rmd text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Binary artefacts must never be normalised by Git.
*.rds binary
*.RDS binary
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary

# Preserve the release-candidate snapshot byte for byte across clones.
experiments/v0L-V/rc1_snapshot/** -text
experiments/v0L-V/rc1_snapshot/** -diff

# Keep the four copied Windows acceptance records byte-identical as evidence.
experiments/v0L-V/acceptance/windows/** -text -diff
